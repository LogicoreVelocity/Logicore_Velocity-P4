APP_PORT=4000
DATABASE_URL=postgres://logicore:password@localhost:5432/logicore_velocity

# JWT
JWT_SECRET=change_me_super_secret
JWT_EXPIRES_IN=8h

# Security / networking
# Comma-separated allowed origins for browser clients (e.g. http://localhost:5173,https://admin.yourdomain.com)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Set true if you're behind a reverse proxy (Nginx, Fly, Render, etc.)
TRUST_PROXY=false
# Rate limit max requests per 15 minutes for /auth/*
AUTH_RATE_LIMIT_MAX=60

# If you enable Google Sheets integration (OAuth/service account), store credentials here:
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_CREDENTIALS_JSON=

# AI controls
AI_ENABLED=true
AI_PROVIDER=local_stub
AI_BUDGET_MONTHLY=0

# Internal Python processing service (not exposed to browsers)
PYTHON_PROCESSOR_URL=http://127.0.0.1:8000
PYTHON_PROCESSOR_TOKEN=replace_with_a_long_random_service_token
PYTHON_PROCESSOR_TIMEOUT_MS=20000
