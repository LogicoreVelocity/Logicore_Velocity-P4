{
  "name": "@logicore/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
  "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
  "build": "tsc -p tsconfig.json",
  "start": "node dist/main.js",
  "db:migrate": "ts-node src/scripts/run-migrations.ts",
