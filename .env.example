# Root-level notes:
# - Copy to .env and also copy apps/api/.env.example -> apps/api/.env (if you want separate envs)
# - The web-admin and mobile app default to API_BASE_URL below.

API_BASE_URL=http://localhost:4000

# Used by Docker Compose for the internal Python processing service.
# Copy the same value into apps/api/.env as PYTHON_PROCESSOR_TOKEN.
PYTHON_PROCESSOR_TOKEN=replace_with_a_long_random_service_token
