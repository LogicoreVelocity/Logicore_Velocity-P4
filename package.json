{
  "name": "logicore-velocity-phase4-fullstack",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web-admin run dev",
    "dev:mobile": "npm --workspace apps/mobile-driver run start",
    "dev:python": "python -m uvicorn logicore_processing.main:app --app-dir services/python-processing --host 127.0.0.1 --port 8000",
    "test:python": "python -m unittest discover -s services/python-processing/tests -v",
    "db:migrate": "npm --workspace apps/api run db:migrate",
    "db:seed": "npm --workspace apps/api run db:seed",
    "lint": "npm --workspace apps/api run lint && npm --workspace apps/web-admin run lint && npm --workspace apps/mobile-driver run lint"
  },
  "dependencies": {
    "append-field": "^1.0.0",
    "autoprefixer": "^10.4.20",
    "dlv": "^1.1.3",
    "es-errors": "^1.3.0",
    "get-intrinsic": "^1.3.0",
    "object-inspect": "^1.13.4",
    "postcss": "^8.4.41",
    "postcss-nested": "^6.2.0",
    "postcss-selector-parser": "^6.1.2",
    "postgres-interval": "^3.0.0",
    "tailwindcss": "^3.4.10",
    "to-regex-range": "^5.0.1",
    "ts-interface-checker": "^0.1.13",
    "xtend": "^4.0.2"
  }
}
